# Environment files (opt-in si besoin)
.env*

# Vercel
.vercel

# Sources brutes (régénérables via scripts/), scratch et caches
/data/raw/
/data/prelys-site/
/scripts/__pycache__/

# OS / éditeurs
*.swp
*~
.idea/
