/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build artefacts
/.next/
/out/

# Production
/build

# TypeScript / build caches
*.tsbuildinfo
next-env.d.ts

# Misc system
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
